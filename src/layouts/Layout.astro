---
interface Props {
	title?: string;
}

const { title = 'KaCinema Oracle — All Your Movies In One Place' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta
			name="description"
			content="KaCinema Oracle — sideload Android + Android TV streaming. VJ-translated movies & series, HLS playback, offline downloads. PC & macOS coming soon."
		/>
		<meta property="og:title" content={title} />
		<meta property="og:description" content="Sideload APK via R2 — Android + Android TV available now. VJ Junior, VJ Jingo & more. PC/macOS coming soon." />
		<meta property="og:type" content="website" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		width: 100%;
	}

	body {
		background: #f6f6fa;
		color: #101014;
		font-family:
			'Jost',
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		padding-bottom: 0;
		-webkit-font-smoothing: antialiased;
	}

	:focus-visible {
		outline: 2px solid #038b7c;
		outline-offset: 2px;
	}
</style>
