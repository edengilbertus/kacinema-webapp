---
interface Props {
	light?: boolean;
	iconSize?: number;
}

const { light = false, iconSize = 40 } = Astro.props;
---

<span class="logo">
	<svg width={iconSize} height={iconSize} viewBox="0 0 64 64" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
		<rect width="64" height="64" rx="14" fill={light ? "#091312" : "#000000"} />
		<g transform="translate(6 18)">
			<path d="M4 12 C10 2, 16 2, 22 12 C28 22, 34 22, 40 12 L44 12 L44 28 L40 28 C34 18, 28 18, 22 28 C16 38, 10 38, 4 28 Z" fill="none" stroke="#1a1a1a" stroke-width="0.5"/>
			<path d="M4.5 12 C10.5 3, 16 3, 21.5 12 L21.5 16 C16 7, 10.5 7, 4.5 16 Z" fill="#2AABEE"/>
			<path d="M22.5 12 C28 22, 34 22, 39.5 12 L39.5 16 C34 25, 28 25, 22.5 16 Z" fill="#2AABEE"/>
			<path d="M4.5 16 C10.5 7, 16 7, 21.5 16 L21.5 22 C16 13, 10.5 13, 4.5 22 Z" fill="#FFFFFF"/>
			<path d="M22.5 16 C28 25, 34 25, 39.5 16 L39.5 22 C34 31, 28 31, 22.5 22 Z" fill="#FFFFFF"/>
			<path d="M4.5 22 C10.5 13, 16 13, 21.5 22 L21.5 27.5 C16 18.5, 10.5 18.5, 4.5 27.5 Z" fill="#1DB954"/>
			<path d="M22.5 22 C28 31, 34 31, 39.5 22 L39.5 27.5 C34 36.5, 28 36.5, 22.5 27.5 Z" fill="#1DB954"/>
			<g fill="#000" opacity="0.9">
				<rect x="6" y="13" width="2" height="2.2" rx="0.4"/><rect x="6" y="16" width="2" height="2.2" rx="0.4"/><rect x="6" y="19" width="2" height="2.2" rx="0.4"/><rect x="6" y="22" width="2" height="2.2" rx="0.4"/>
				<rect x="18" y="13.5" width="2" height="2.2" rx="0.4"/><rect x="18" y="16.5" width="2" height="2.2" rx="0.4"/><rect x="18" y="19.5" width="2" height="2.2" rx="0.4"/>
				<rect x="33" y="14" width="1.8" height="2" rx="0.4"/><rect x="33" y="17" width="1.8" height="2" rx="0.4"/><rect x="33" y="20" width="1.8" height="2" rx="0.4"/><rect x="33" y="23" width="1.8" height="2" rx="0.4"/>
				<rect x="39" y="14.5" width="1.8" height="2" rx="0.4"/><rect x="39" y="17.5" width="1.8" height="2" rx="0.4"/><rect x="39" y="20.5" width="1.8" height="2" rx="0.4"/>
			</g>
			<g fill="#FFFFFF">
				<rect x="43.5" y="15" width="4" height="10" rx="0.5"/>
				<path d="M47.5 17 L52 14 L52 30 L47.5 27 Z" fill="#FFFFFF"/>
			</g>
		</g>
	</svg>
	<span class="word" class:list={{ light }}>KaCinema<span class="oracle">Oracle</span></span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.word {
		font-weight: 800;
		letter-spacing: -0.035em;
		color: #0b0b0f;
		display: inline-flex;
		gap: 4px;
		align-items: baseline;
	}

	.oracle {
		font-weight: 400;
		letter-spacing: -0.02em;
		color: #d02568;
	}

	.word.light {
		color: #ffffff;
	}
	.word.light .oracle {
		color: #ffffff;
		opacity: 0.9;
	}
</style>
