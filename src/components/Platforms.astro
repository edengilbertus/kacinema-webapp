<style>
	.platforms {
		margin: 0;
		padding: 110px 52px 36px;
		background: #091312;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.head {
		max-width: 720px;
		margin: 0 auto 22px;
		text-align: center;
	}
	.head h2 {
		margin: 0;
		font-size: clamp(22px, 2.6vw, 32px);
		letter-spacing: -0.03em;
		line-height: 1.1;
		color: #ffffff;
	}
	.head p {
		margin: 10px auto 0;
		max-width: 620px;
		color: #c7c7cc;
		line-height: 1.5;
		font-size: 15px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 12px;
		max-width: 920px;
		margin: 0 auto;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 16px 14px 16px;
		border-radius: 16px;
		background: linear-gradient(135deg, #fbd9e7 0 49.7%, #ffffff 49.7% 50.3%, #1c1c1e 50.3% 100%);
		border: 1px solid rgba(255, 255, 255, 0.14);
		text-decoration: none;
		transition:
			transform 0.15s,
			border-color 0.2s,
			box-shadow 0.2s;
	}
	.icon {
		width: 48px;
		height: 48px;
		border-radius: 13px;
		display: grid;
		place-items: center;
		background: #fff;
		border: 1px solid rgba(255,255,255,0.12);
		color: #091312;
	}
	.icon-android, .icon-tv, .icon-mac {
		width: auto;
		padding: 8px 12px;
		border-radius: 999px;
		height: 44px;
		background: #fff;
	}
	.icon-pc { background: #fff; width: 48px; }
	.icon.dim {
		opacity: 0.52;
		background: rgba(255,255,255,0.5);
		border-style: dashed;
	}
	.card:not(.soon):hover {
		transform: translateY(-1px);
		border-color: rgba(0, 163, 255, 0.28);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
	}
	.card.soon {
		opacity: 0.78;
		background: linear-gradient(135deg, rgba(251, 217, 231, 0.9) 0 49.7%, #ffffff 49.7% 50.3%, rgba(28, 28, 30, 0.9) 50.3% 100%);
		border-style: dashed;
		border-color: rgba(255, 255, 255, 0.18);
		cursor: default;
	}

