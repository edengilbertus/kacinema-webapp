<style>
	.hero {
		text-align: center;
		padding: 44px 24px 0;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0 auto 18px;
		padding: 7px 14px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.72);
		border: 1px solid rgba(23, 23, 27, 0.08);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #6b6b77;
	}

	h1 {
		margin: 0;
		font-weight: 800;
		font-size: clamp(44px, 6.5vw, 92px);
		line-height: 1.06;
		letter-spacing: -0.04em;
		color: #0b0b0f;
	}

	.lead {
		margin: 22px auto 28px;
		max-width: 640px;
		font-size: clamp(16px, 1.4vw, 19px);
		line-height: 1.5;
		color: #33333a;
	}

	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		justify-content: center;
		margin-bottom: 18px;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 22px;
		border-radius: 999px;
		font-weight: 700;
		font-size: 15px;
		text-decoration: none;
		transition:
			transform 0.15s,
			background 0.2s,
			border-color 0.2s;
	}

	.cta.primary {
		background: #038b7c;
		color: #fff;
		box-shadow: 0 10px 28px rgba(3, 139, 124, 0.28);
	}

	.cta.primary:hover {
		background: #027a6d;
		transform: translateY(-1px);
	}



	.platforms {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		justify-content: center;
		margin-bottom: 10px;
	}

	.platformLogo {
		width: 42px;
		height: 42px;
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: rgba(255, 255, 255, 0.82);
		border: 1px solid rgba(23, 23, 27, 0.08);
		color: #0b0b0f;
		box-shadow: 0 4px 16px rgba(23, 23, 27, 0.07);
	}
	.platformLogo.androidStacked {
		width: auto;
		padding: 6px 14px;
		border-radius: 999px;
		height: 42px;
	}
	.platformLogo.androidTvStacked {
		width: auto;
		padding: 6px 14px;
		border-radius: 999px;
		height: 42px;
	}
	.platformLogo.macosStacked {
		width: auto;
		padding: 6px 14px;
		border-radius: 999px;
		height: 42px;
	}
	.platformLogo.soon {
		opacity: 0.52;
		background: rgba(255, 255, 255, 0.5);
		border-style: dashed;
	}
</style>
