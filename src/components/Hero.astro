---
import PhoneMockup from './PhoneMockup.astro';
interface Props { version?: { name: string; code: number; apkUrl: string } }
const { version } = Astro.props as Props;
const verName = version?.name ?? "1.1.21";
const dlHref = version?.apkUrl ?? "#download";
---

<section class="hero">
	<p class="eyebrow" data-eyebrow>KaCinema Oracle — v{verName}</p>
	<h1>
		All Your Movies
		<br />
		In One Place.
	</h1>
	<p class="lead">
		Stream the latest movies and series, VJ-translated in Luganda and original versions. For
		Android &amp; Android TV — PC &amp; macOS coming soon.
	</p>
	<div class="ctas">
		<a class="cta primary" href={dlHref} data-dl="primary" target={dlHref.startsWith("http") ? "_blank" : undefined} rel={dlHref.startsWith("http") ? "noopener" : undefined}>
			<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
				<path d="M12 16.5 6.2 10.7 7.6 9.3l3.4 3.4V3h2v10.3l3.4-3.4 1.4 1.4L12 16.5ZM4.5 18v2h15v-2H4.5Z" />
			</svg>
			<span>Download</span>
		</a>
	</div>
	<div class="platforms" aria-label="Supported platforms">
		<span class="platformLogo androidStacked" title="Android — Available">
