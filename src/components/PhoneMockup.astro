---
import Logo from './Logo.astro';
---

<div class="phone">
	<span class="side side-vol-up" aria-hidden="true"></span>
	<span class="side side-vol-down" aria-hidden="true"></span>
	<span class="side side-power" aria-hidden="true"></span>

	<div class="screen">
		<div class="statusbar">
			<span class="time">9:41</span>
			<span class="island" aria-hidden="true"></span>
			<span class="status-icons" aria-hidden="true">
				<svg width="18" height="12" viewBox="0 0 18 12" fill="#fff">
					<rect x="0" y="7" width="3" height="5" rx="1"></rect>
					<rect x="5" y="5" width="3" height="7" rx="1"></rect>
					<rect x="10" y="2.5" width="3" height="9.5" rx="1"></rect>
					<rect x="15" y="0" width="3" height="12" rx="1"></rect>
				</svg>
				<svg width="17" height="12" viewBox="0 0 17 12" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round">
					<path d="M1.5 4a10.5 10.5 0 0 1 14 0"></path>
					<path d="M4 6.8a7 7 0 0 1 9 0"></path>
					<path d="M6.6 9.5a3.4 3.4 0 0 1 3.8 0"></path>
				</svg>
				<svg width="25" height="12" viewBox="0 0 25 12" fill="none">
					<rect x="0.5" y="0.5" width="21" height="11" rx="3.5" stroke="#fff" opacity="0.5"></rect>
					<rect x="2" y="2" width="18" height="8" rx="2" fill="#fff"></rect>
					<path d="M23 4v4c1.2-.3 2-1 2-2s-.8-1.7-2-2z" fill="#fff" opacity="0.5"></path>
				</svg>
			</span>
		</div>

		<div class="app-header">
			<Logo light iconSize={24} />
		</div>

		<div class="realShot">
			<img
				src="/screenshots/real/photo_2026-08-07_15-27-34.jpg"
				alt="KaCinema real screenshot — Home"
				loading="eager"
				decoding="async"
			/>
		</div>
	</div>
</div>

<style>
	.phone {
		position: relative;
		width: min(392px, 92vw);
		margin: 32px auto -80px;
	}

	.side {
		position: absolute;
		width: 5px;
		background: #0d0d10;
		border-radius: 4px;
	}

	.side-vol-up { left: -4px; top: 190px; height: 42px; }
	.side-vol-down { left: -4px; top: 244px; height: 42px; }
	.side-power { right: -4px; top: 220px; height: 72px; }

	.screen {
		display: flex;
		flex-direction: column;
		height: min(840px, 72dvh);
		aspect-ratio: 392 / 840;
		max-height: 840px;
		background: #091312;
		border: 8px solid #0d0d10;
		border-radius: 48px;
		overflow: hidden;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
	}

	@media (max-width: 520px) {
		.phone { margin: 20px auto -40px; width: min(340px, 88vw); }
		.screen { height: auto; border-width: 6px; border-radius: 36px; }
		.side { display: none; }
		.statusbar { padding: 12px 18px 0; height: 38px; }
		.island { width: 90px; height: 26px; top: 10px; }
		.time { font-size: 12px; }
		.app-header { margin-top: 6px; }
		.realShot { margin: 10px 8px 8px; border-radius: 18px; }
	}

	.statusbar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 16px 26px 0;
		height: 46px;
		color: #fff;
	}

	.time { font-size: 14px; font-weight: 600; }
	.island {
		position: absolute;
		top: 13px;
		left: 50%;
		transform: translateX(-50%);
		width: 116px;
		height: 33px;
		background: #0d0d10;
		border-radius: 20px;
	}
	.status-icons { display: inline-flex; align-items: center; gap: 7px; }

	.app-header {
		display: flex;
		justify-content: center;
		margin-top: 10px;
		font-size: 20px;
	}

	.realShot {
		flex: 1;
		margin: 12px 10px 10px;
		border-radius: 22px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: #000;
	}
	.realShot img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
